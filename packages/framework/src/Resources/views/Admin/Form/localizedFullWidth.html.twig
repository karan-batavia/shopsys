{% block localized_full_width_widget %}
    <div class="mb-3">
        <label class="form-label {% if required %}required{% endif %}">{{ label }}</label>
        {% for locale, formName in form.children %}
            <div class="input-icon mb-3">
                {% if formName.vars.block_prefixes | slice(-2,1) | first is not same as('ckeditor') %}
                    <span class="input-icon-addon">
                            {{ localeFlag(locale) }}
                        </span>
                {% endif %}
                {{ form_widget(formName, { localized: true, locale: locale }) }}
                {{ form_errors(formName) }}
            </div>
        {% endfor %}
    </div>
{% endblock localized_full_width_widget %}
